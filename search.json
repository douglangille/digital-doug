---
layout: null
sitemap: false
---
[{% for p in site.posts %}{% assign t = p.image | default: p.header.teaser %}{% include excerpt.html post=p %}{"title":{{ p.title | strip_html | jsonify }},"url":{{ p.url | relative_url | jsonify }},"date":{{ p.date | date: "%b %-d, %Y" | jsonify }},"excerpt":{{ lead | jsonify }},"tags":{{ p.tags | join: " " | jsonify }},"image":{% if thumb %}{{ thumb | relative_url | jsonify }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
